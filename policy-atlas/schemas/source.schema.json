{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/apolmig/agencytransfer/policy-atlas/schemas/source.schema.json",
  "title": "Policy Atlas source",
  "type": "object",
  "required": ["source_id", "title", "institution_author", "source_class", "direct_url", "verification_level"],
  "properties": {
    "source_id": {"type": "string", "pattern": "^SRC-[0-9]{3}$"},
    "title": {"type": "string", "minLength": 1},
    "institution_author": {"type": "string", "minLength": 1},
    "source_class": {"type": "string", "minLength": 1},
    "direct_url": {"type": "string", "format": "uri", "pattern": "^https?://"},
    "verification_level": {"type": "string", "minLength": 1},
    "publication_status": {"enum": ["claim_checked_source", "candidate_source"]}
  },
  "additionalProperties": true
}
