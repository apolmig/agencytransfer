{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/apolmig/agencytransfer/policy-atlas/schemas/stable-core-candidate.schema.json",
  "title": "Policy Atlas proposed stable-core candidate",
  "type": "object",
  "required": [
    "selection_protocol_version",
    "source_release",
    "selection_design",
    "preregistration_status",
    "display_order",
    "implementation_id",
    "inclusion_status",
    "publication_decision_posture",
    "selection_rationale",
    "evidence_gap",
    "rank_eligibility",
    "effect_direction_used_for_selection",
    "claim_disposition_status",
    "gate_assessment_status",
    "independent_review_status",
    "stable_core_admission_status",
    "ranking_ready"
  ],
  "properties": {
    "selection_protocol_version": {"const": "stable-core-selection-v0.1"},
    "source_release": {"const": "v0.1.0-beta.2"},
    "selection_design": {"const": "retrospective_editorial_selection"},
    "preregistration_status": {"const": "not_preregistered"},
    "display_order": {
      "oneOf": [
        {"type": "string", "pattern": "^[1-9][0-9]?$"},
        {"type": "integer", "minimum": 1, "maximum": 99}
      ]
    },
    "implementation_id": {"type": "string", "pattern": "^I-[0-9]{3}$"},
    "inclusion_status": {"const": "proposed_core_candidate"},
    "publication_decision_posture": {"const": "not_assessed"},
    "selection_rationale": {"type": "string", "minLength": 1},
    "evidence_gap": {"type": "string", "minLength": 1},
    "rank_eligibility": {
      "type": "string",
      "pattern": "^not_eligible_now__"
    },
    "effect_direction_used_for_selection": {"enum": ["false", false]},
    "claim_disposition_status": {"const": "incomplete"},
    "gate_assessment_status": {"const": "not_assessed"},
    "independent_review_status": {"const": "pending"},
    "stable_core_admission_status": {"const": "blocked_pending_verification"},
    "ranking_ready": {"enum": ["false", false]}
  },
  "not": {"required": ["decision_tier"]},
  "additionalProperties": true
}
