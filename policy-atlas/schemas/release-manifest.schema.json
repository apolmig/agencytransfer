{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/apolmig/agencytransfer/policy-atlas/schemas/release-manifest.schema.json",
  "title": "Policy Atlas release manifest",
  "type": "object",
  "required": ["artifact", "artifact_version", "release_stage", "source_snapshot_version", "source_as_of_date", "stable_release_ready", "stable_release_blockers", "counts", "files"],
  "properties": {
    "artifact": {"const": "Agency Transfer Policy Atlas"},
    "artifact_version": {"type": "string"},
    "release_stage": {"const": "research-preview"},
    "source_snapshot_version": {"const": "sheets-v0.3"},
    "source_as_of_date": {"type": "string", "format": "date"},
    "stable_release_ready": {"const": false},
    "stable_release_blockers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "formats": {"type": "array", "items": {"enum": ["csv", "parquet"]}},
    "counts": {"type": "object"},
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["sha256", "bytes"],
        "properties": {
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
