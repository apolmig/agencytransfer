{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://miguelguerrero.eu/agencytransfer/schemas/project-manifest.schema.json",
  "title": "Agency Transfer Research Programme Manifest",
  "description": "Canonical metadata for the programme, its four research parts, public outputs, controlled evidence, routes, and publication boundaries.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "programme",
    "evidence_grades",
    "causal_topology",
    "research_parts",
    "artifacts",
    "routes",
    "publication_rules",
    "known_blockers"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "programme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "subtitle",
        "flagship_title",
        "flagship_subtitle",
        "lead",
        "scope_statement",
        "secondary_lens",
        "thesis",
        "status",
        "author",
        "affiliation",
        "programme_period",
        "evidence_freeze",
        "last_updated",
        "canonical_site",
        "canonical_repository",
        "claim_boundary"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string",
          "minLength": 1
        },
        "flagship_title": {
          "type": "string",
          "minLength": 1
        },
        "flagship_subtitle": {
          "type": "string",
          "minLength": 1
        },
        "lead": {
          "type": "string",
          "minLength": 1
        },
        "scope_statement": {
          "type": "string",
          "minLength": 1
        },
        "secondary_lens": {
          "type": "string",
          "minLength": 1
        },
        "thesis": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "working_programme",
            "frozen_release",
            "archived"
          ]
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "affiliation": {
          "type": "string",
          "minLength": 1
        },
        "programme_period": {
          "type": "string",
          "minLength": 1
        },
        "evidence_freeze": {
          "type": "string",
          "format": "date"
        },
        "last_updated": {
          "type": "string",
          "format": "date"
        },
        "canonical_site": {
          "type": "string",
          "format": "uri"
        },
        "canonical_repository": {
          "type": "string",
          "format": "uri"
        },
        "claim_boundary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence_grades": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "definition"
        ],
        "properties": {
          "id": {
            "enum": [
              "established",
              "strong_inference",
              "plausible_hypothesis",
              "speculative_scenario",
              "open_question"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "causal_topology": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "research_parts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/researchPart"
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "routes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_navigation",
        "canonical_routes",
        "redirects"
      ],
      "properties": {
        "primary_navigation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/navItem"
          }
        },
        "canonical_routes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^/"
          }
        },
        "redirects": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "type": "string",
                "pattern": "^/"
              },
              "to": {
                "type": "string",
                "pattern": "^/"
              }
            }
          }
        }
      }
    },
    "publication_rules": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "known_blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "nullableUri": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "navItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "path"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        }
      }
    },
    "researchPart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "number",
        "title",
        "question",
        "observed_unit",
        "strongest_supported_claim",
        "claim_ceiling",
        "primary_evidence_grade",
        "headline_metrics",
        "artifact_ids"
      ],
      "properties": {
        "id": {
          "enum": [
            "part-i",
            "part-ii",
            "part-iii",
            "part-iv"
          ]
        },
        "number": {
          "enum": [
            "I",
            "II",
            "III",
            "IV"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "observed_unit": {
          "type": "string",
          "minLength": 1
        },
        "strongest_supported_claim": {
          "type": "string",
          "minLength": 1
        },
        "claim_ceiling": {
          "type": "string",
          "minLength": 1
        },
        "primary_evidence_grade": {
          "enum": [
            "established",
            "strong_inference",
            "plausible_hypothesis",
            "speculative_scenario",
            "open_question"
          ]
        },
        "headline_metrics": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "number"
          }
        },
        "counting_note": {
          "type": "string"
        },
        "artifact_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "title",
        "kind",
        "part",
        "role",
        "status",
        "visibility",
        "canonical_url",
        "source_url",
        "repo_path",
        "source_version",
        "public_release_version",
        "evidence_cutoff",
        "planned_route",
        "claim_ceiling"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "working_paper",
            "white_paper",
            "brief",
            "poster",
            "video",
            "dataset",
            "interactive_research",
            "research_tool",
            "methods_record",
            "evaluation_audit",
            "evidence_bundle",
            "controlled_evidence"
          ]
        },
        "part": {
          "enum": [
            "programme",
            "cross-programme",
            "part-i",
            "part-ii",
            "part-iii",
            "part-iv"
          ]
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "published",
            "release_candidate",
            "working",
            "withheld",
            "legacy",
            "superseded",
            "hosting_required"
          ]
        },
        "visibility": {
          "enum": [
            "public",
            "private",
            "withheld"
          ]
        },
        "canonical_url": {
          "$ref": "#/$defs/nullableUri"
        },
        "source_url": {
          "$ref": "#/$defs/nullableUri"
        },
        "repo_path": {
          "$ref": "#/$defs/nullableString"
        },
        "source_version": {
          "$ref": "#/$defs/nullableString"
        },
        "public_release_version": {
          "$ref": "#/$defs/nullableString"
        },
        "evidence_cutoff": {
          "oneOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "planned_route": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^/"
            },
            {
              "type": "null"
            }
          ]
        },
        "claim_ceiling": {
          "type": "string",
          "minLength": 1
        },
        "publication_note": {
          "type": "string"
        },
        "responsible_release_note": {
          "type": "string"
        },
        "media": {
          "$ref": "#/$defs/media"
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "language",
        "duration_seconds",
        "embed_url",
        "poster_frame_url",
        "captions_url",
        "transcript_url",
        "hosting_status"
      ],
      "properties": {
        "format": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 2
        },
        "duration_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "embed_url": {
          "$ref": "#/$defs/nullableUri"
        },
        "poster_frame_url": {
          "$ref": "#/$defs/nullableUri"
        },
        "captions_url": {
          "$ref": "#/$defs/nullableUri"
        },
        "transcript_url": {
          "$ref": "#/$defs/nullableUri"
        },
        "hosting_status": {
          "enum": [
            "durable_public",
            "private_master_only",
            "temporary_source_only",
            "missing"
          ]
        }
      }
    }
  }
}
