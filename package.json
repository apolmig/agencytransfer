{
  "name": "agency-transfer-benchmark",
  "private": true,
  "version": "0.2.0-draft",
  "description": "Maintained research programme on frontier AI, harmful manipulation, election security, agency transfer, and democratic power.",
  "homepage": "https://miguelguerrero.eu/agencytransfer/",
  "repository": {
    "type": "git",
    "url": "https://github.com/apolmig/agencytransfer.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run prepare:media && vite",
    "prepare:media": "node scripts/extract-cde-rift-image.mjs",
    "analyze:stitching": "node scripts/analyze-stitching-readiness.mjs",
    "generate:frontier": "node scripts/build-frontier-data.mjs",
    "rebuild:historical-pilot-notes": "node scripts/publish-ape-pilot.mjs",
    "typecheck": "tsc --noEmit",
    "validate:programme": "node scripts/validate-programme-manifest.mjs",
    "validate:data": "node scripts/validate-data.mjs",
    "build": "npm run prepare:media && npm run validate:programme && npm run validate:data && npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  }
}
